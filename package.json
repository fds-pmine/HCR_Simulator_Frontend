{
  "name": "hcr-simulator",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "HCR Simulator — a Blockly and Web 3D robotic haircut simulation",
  "homepage": "https://web.hcr.rs",
  "//author": "Required, not decorative: electron-builder derives the deb and rpm `maintainer` field from it and refuses to package those formats without one.",
  "author": "JerrySu5379 <jerrysu5379@gmail.com>",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:performance": "playwright test --config playwright.performance.config.ts",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "vectors": "vitest run --config vectors.config.ts",
    "reachability": "vitest run --config reachability.config.ts",
    "cutter-grid:audit": "vitest run --config cutter-grid-audit.config.ts",
    "cutter-grid:profile": "vitest run --config cutter-grid-profile.config.ts",
    "cutter-grid:plan": "vitest run --config cutter-grid-plan.config.ts",
    "cutter-grid:motion-v3-fixture": "vitest run --config cutter-grid-motion-v3.config.ts",
    "ruckig:wasm:build": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/ruckig-wasm/build-ruckig-local-wasm.ps1",
    "ruckig:wasm:stage": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/ruckig-wasm/stage-ruckig-local-wasm.ps1",
    "electron:dev": "cross-env VITE_HCR_API_BASE_URL=http://127.0.0.1:18623 concurrently -k -n vite,electron -c cyan,magenta \"vite --strictPort\" \"wait-on http://localhost:5173 && cross-env ELECTRON_START_URL=http://localhost:5173 electron .\"",
    "electron:preview": "npm run build:desktop && electron .",
    "build:desktop": "cross-env VITE_HCR_API_BASE_URL=https://api.hcr.rs npm run build",
    "app:build": "npm run build:desktop && electron-builder --publish never"
  },
  "main": "electron/main.cjs",
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "blockly": "^13.2.0",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "build": {
    "appId": "rs.hcr.simulator",
    "productName": "HCR Simulator",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "artifactName": "${name}-${version}-${arch}.${ext}",
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.education"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "Education",
      "synopsis": "Blockly and Web 3D robotic haircut simulation",
      "desktop": {
        "entry": {
          "Name": "HCR Simulator",
          "Categories": "Education;Science;Robotics;"
        }
      }
    },
    "publish": null
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.1",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^29.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.53.1",
    "vite": "^8.1.5",
    "vitest": "^4.1.0"
  }
}
